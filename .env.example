# Local MySQL (default for development)
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:root@localhost:3306/noc_dev

# Set to "true" when connecting to managed MySQL that requires TLS
# (e.g. Hostinger MySQL over the public network).
# DATABASE_SSL=true

# Admin panel auth (Phase 3.1)
# Single shared password — anyone with it can edit places.
ADMIN_PASSWORD=changeme
# Random string used to sign admin session JWTs. Minimum 16 chars.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-me-with-32-bytes-of-random-hex
